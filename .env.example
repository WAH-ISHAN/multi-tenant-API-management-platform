NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Demo HS256 token validation. Use Keycloak/OIDC JWKS in production.
JWT_DEMO_SECRET=change-me-in-local-dev
JWT_ISSUER=http://localhost:8080/demo-idp
JWT_AUDIENCE=zero-trust-gateway

# Optional OIDC/JWKS validation settings for Keycloak.
OIDC_JWKS_URI=http://localhost:18080/realms/zero-trust/protocol/openid-connect/certs
OIDC_ISSUER=http://localhost:18080/realms/zero-trust

TENANT_HEADER=x-tenant-id
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
